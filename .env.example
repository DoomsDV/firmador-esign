# Plantilla de configuración. Copiar a .env y completar los secretos.
# El .env real está en .gitignore: NUNCA lo subas a git.

# --- Base de datos Oracle (esquema ESIGN, misma ADB que aoxdev) ---
DB_USER=esign
DB_PASS=__COMPLETAR__
DB_HOST=adb.sa-saopaulo-1.oraclecloud.com
DB_PORT=1522
DB_SERVICE=g9549f707e8ebfa_aoxdev_high.adb.oraclecloud.com
ORACLE_WALLET_PATH=C:\OracleWallet\Wallet_aoxdev
# Password del wallet cifrado (misma instancia ADB que aoxdev)
ORACLE_WALLET_PASSWORD=__COMPLETAR__

# --- Certificado de firma (.p12) ---
CERT_P12_PATH=C:\Users\HP\Documents\dnit-doc\7156160_identity_go.p12
CERT_P12_PASSWORD=__COMPLETAR__

# --- SIFEN (solo ambiente TEST) ---
SIFEN_ENV=test
# CSC genéricos de TEST (Marandú). NO usar CSC de producción en test.
SIFEN_ID_CSC=0001
SIFEN_CSC=ABCD0000000000000000000000000000
SIFEN_RUC=6038964
SIFEN_DV=8
SIFEN_RAZON_SOCIAL=VILLASANTI VERGARA DANIEL RAMON
# Timbrado TEST = RUC sin DV pad a 8 (guía DNIT / XSD tdNumTim).
SIFEN_TIMBRADO=06038964
# Fecha habilitación SGTM = Form.364 (2026-07-09).
SIFEN_FE_INI_T=2026-07-09
SIFEN_EST=001
SIFEN_PUN_EXP=001
SIFEN_WS_SYNC=https://sifen-test.set.gov.py/de/ws/sync/recibe.wsdl
SIFEN_WS_ASYNC=https://sifen-test.set.gov.py/de/ws/async/recibe-lote.wsdl
SIFEN_WS_EVENTO=https://sifen-test.set.gov.py/de/ws/eventos/evento.wsdl
SIFEN_QR_BASE=https://ekuatia.set.gov.py/consultas-test/qr?
# SIFEN_SEND=false para generar XML/KuDE sin enviar a sifen-test.
SIFEN_SEND=true

# --- API multi-tenant (cmd/server) ---
# Raíz del esquema ORDS de esign (sin barra final). Las rutas internas cuelgan de
# {ESIGN_ORDS_BASE}/internal/v1/... El módulo interno exige X-Service-Token.
ESIGN_ORDS_BASE=https://g9549f707e8ebfa-aoxdev.adb.sa-saopaulo-1.oraclecloudapps.com/ords/esign
# X-Service-Token compartido Go<->ORDS (app_parameter.SERVICE_TOKEN). Ver seeds/01.
ESIGN_SERVICE_TOKEN=__COMPLETAR__
# Clave maestra AES-256 (64 hex = 32 bytes) para descifrar certificado/CSC. Fuera del repo.
# Generar: openssl rand -hex 32
ESIGN_MASTER_KEY=__COMPLETAR__
# Dirección de escucha del servidor HTTP.
SERVER_ADDR=:8080
# OpenSSL para normalizar .p12 DNIT/Marandú (opcional; default: openssl en PATH).
# ESIGN_OPENSSL_PATH=/usr/bin/openssl
# Orígenes del panel permitidos para CORS (comma-separated).
ESIGN_CORS_ORIGINS=https://staging.etick.uno,https://etick.uno,http://localhost:5173
# TTL del cache de tenants resueltos (opcional; default 5m).
ESIGN_TENANT_CACHE_TTL=5m

# --- JWT del panel (mediacion /v1/panel/*) ---
# Debe ser IDENTICO a app_parameter.JWT_TOKEN (bytes ASCII del string, no hex-decode).
ESIGN_JWT_SECRET=__COMPLETAR__
ESIGN_JWT_ISSUER=esign-api
ESIGN_JWT_AUDIENCE=esign-app

# --- Worker de reenvio FIRMADO ---
ESIGN_RETRY_ENABLED=true
ESIGN_RETRY_INTERVAL=60s
ESIGN_RETRY_MAX=10
ESIGN_RETRY_BATCH=25

# --- Cola durable KuDE (PDF) ---
ESIGN_KUDE_QUEUE_ENABLED=true
ESIGN_KUDE_QUEUE_INTERVAL=15s
ESIGN_KUDE_QUEUE_BATCH=10
ESIGN_KUDE_QUEUE_LEASE=120

# --- KuDE (PDF) via Gotenberg ---
# Local: docker compose up -d gotenberg -> http://localhost:3000
# VPS: contenedor Gotenberg compartido (staging/prod), URL segun el docker network del host.
GOTENBERG_URL=http://localhost:3000
# Timeout de la llamada a Gotenberg (best-effort; si falla no afecta la emision SIFEN).
ESIGN_KUDE_TIMEOUT=20s
